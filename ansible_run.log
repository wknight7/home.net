    "msg": "AnsibleError: template error while templating string: Missing end of comment tag. String: #!/bin/bash\n\n# System health check script\n# Runs daily and sends notifications for issues\n\nNTFY_SERVER=\"{{ ntfy_server }}\"\nNTFY_USER=\"{{ ntfy_username }}\"\nNTFY_PASS=\"{{ ntfy_password }}\"\nHOSTNAME=\"{{ ansible_hostname }}\"\nTOPIC=\"system-${HOSTNAME}\"\n\n# Initialize issues array\nISSUES=()\nPRIORITY=\"1\"  # default (low)\n\n# Check disk usage\nDISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')\nif [ \"$DISK_USAGE\" -gt 85 ]; then\n    ISSUES+=(\"🔴 DISK: ${DISK_USAGE}% full - cleanup needed\")\n    PRIORITY=\"4\"  # high\nfi\n\n# Check memory usage (avoid bc dependency)\nMEM_USAGE=$(free | awk '/^Mem:/ {printf \"%.1f\", $3/$2 * 100.0}')\nif (( $(echo \"$MEM_USAGE > 90.0\" | awk '{print ($1 > 90.0)}') )); then\n    ISSUES+=(\"🟡 MEMORY: ${MEM_USAGE}% - high load detected\")\n    [ \"$PRIORITY\" -lt \"4\" ] && PRIORITY=\"4\"  # high\nfi\n\n# Check for failed systemd services\nFAILED_SERVICES=$(systemctl --failed --no-legend | wc -l)\nif [ \"$FAILED_SERVICES\" -gt 0 ]; then\n    FAILED_LIST=$(systemctl --failed --no-legend | awk '{print $1}' | tr '\\n' ' ' | sed 's/ $//')\n    ISSUES+=(\"🔴 SERVICES: ${FAILED_SERVICES} failed - $FAILED_LIST\")\n    PRIORITY=\"5\"  # urgent\nfi\n\n# Check load average (avoid bc dependency)\nLOAD_AVG=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//')\nCPU_COUNT=$(nproc)\nLOAD_THRESHOLD=$(awk \"BEGIN {print $CPU_COUNT * 2}\")\nif (( $(echo \"$LOAD_AVG $LOAD_THRESHOLD\" | awk '{print ($1 > $2)}') )); then\n    ISSUES+=(\"🟡 LOAD: ${LOAD_AVG} (${CPU_COUNT} cores) - high system load\")\n    [ \"$PRIORITY\" -lt \"4\" ] && PRIORITY=\"4\"  # high\nfi\n\n# Check for security updates\nif command -v apt &> /dev/null; then\n    apt update -qq 2>/dev/null\n    SECURITY_UPDATES=$(apt list --upgradable 2>/dev/null | grep -c \"ubuntu.*-security\" || echo \"0\")\n    if [ \"$SECURITY_UPDATES\" -gt 0 ]; then\n        ISSUES+=(\"🟡 SECURITY: ${SECURITY_UPDATES} updates available\")\n        [ \"$PRIORITY\" -lt \"3\" ] && PRIORITY=\"3\"  # default/normal\n    fi\nfi\n\n# Send consolidated notification if there are issues\nif [ ${#ISSUES[@]} -gt 0 ]; then\n    # Build message with system info\n    MESSAGE=\"Host: ${HOSTNAME}\nTime: $(date)\nUptime: $(uptime -p)\n\nIssues detected:\n$(printf '%s\\n' \"${ISSUES[@]}\")\n\nSystem Status:\n• Disk Usage: ${DISK_USAGE}%\n• Memory Usage: ${MEM_USAGE}%\n• Load Average: ${LOAD_AVG}\n• Failed Services: ${FAILED_SERVICES}\"\n\n    # Determine title based on severity\n    case \"$PRIORITY\" in\n        \"5\") TITLE=\"🚨 [${HOSTNAME}] CRITICAL System Issues\" ;;\n        \"4\") TITLE=\"⚠️  [${HOSTNAME}] System Warnings\" ;;\n        \"3\") TITLE=\"ℹ️  [${HOSTNAME}] System Updates\" ;;\n        *) TITLE=\"✅ [${HOSTNAME}] System Notice\" ;;\n    esac\n\n    curl -s \\\n        -u \"$NTFY_USER:$NTFY_PASS\" \\\n        -d \"$MESSAGE\" \\\n        -H \"Title: $TITLE\" \\\n        -H \"Priority: $PRIORITY\" \\\n        -H \"Tags: health,${HOSTNAME}\" \\\n        \"$NTFY_SERVER/$TOPIC\"\nelse\n    echo \"No issues detected\"\nfi\n. Missing end of comment tag"
}
